# Copier vers .env sur le serveur (jamais commité).
PORT=8080
# Connexion MariaDB : socket Unix (recommandé sur le VPS) ou hôte/port.
DB_SOCKET=/run/mysqld/mysqld.sock
# DB_HOST=localhost
# DB_PORT=3306
DB_NAME=editor
DB_USER=editor
DB_PASSWORD=
# Origines autorisées (CORS), séparées par des virgules.
ALLOWED_ORIGINS=https://brahmiamine.github.io,http://localhost:3000
APP_URL=https://brahmiamine.github.io/editor/
# E-mails (mot de passe oublié, lien magique) : laisser SMTP_HOST vide pour désactiver.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
